# mcp-switchboard configuration.
#
# Every setting can be given either literally or as a path to a file holding the
# value - any value starting with "/" that is an existing regular file is read
# from that file. That is how secrets are passed under NixOS/sops without any
# separate *_FILE variables:
#
#   MCP_SWITCHBOARD_TUNNEL_TOKEN=/run/secrets/mcp-switchboard/tunnel-token

# --- client ---------------------------------------------------------------
MCP_SWITCHBOARD_HUB_URL=wss://switchboard.example.com
MCP_SWITCHBOARD_TUNNEL_TOKEN=change-me
# Identifies this machine, and is what tools get tagged with. Defaults to the hostname.
#MCP_SWITCHBOARD_LABEL=legion5
# Project name shown next to this client in the hub. Defaults to the devcontainer name, git root or directory name.
#MCP_SWITCHBOARD_PROJECT_NAME=myproject
#MCP_SWITCHBOARD_CONFIG=./mcp.json

# --- hub ------------------------------------------------------------------
# The tunnel listener is the only one meant to be publicly reachable, and always
# needs the token above. The private listener (console, /api, /mcp, /metrics)
# binds loopback and is unauthenticated by default.
#MCP_SWITCHBOARD_TUNNEL_HOST=127.0.0.1
#MCP_SWITCHBOARD_TUNNEL_PORT=8097
#MCP_SWITCHBOARD_PRIVATE_HOST=127.0.0.1
#MCP_SWITCHBOARD_PRIVATE_PORT=8099
#MCP_SWITCHBOARD_PRIVATE_TOKEN=
#MCP_SWITCHBOARD_DATA_DIR=/var/lib/mcp-switchboard
#MCP_SWITCHBOARD_LOG_LEVEL=INFO

# --- console "Endpoints" panel -------------------------------------------
# Externally reachable address of the tunnel listener (e.g. a Tailscale Funnel
# URL). Only used to render the copyable client-install command; unset, the
# console just explains what to set.
#MCP_SWITCHBOARD_PUBLIC_URL=https://switchboard.example.com
# Base URL the console prints for /mcp endpoints. Defaults to
# http://127.0.0.1:<private port>.
#MCP_SWITCHBOARD_LOCAL_BASE_URL=

# --- web push notifications -----------------------------------------------
# A phone notification when a top-level chat's run finishes or needs your
# approval. Both keys are required; either missing disables push entirely
# (the /api/push/* routes 404). Generate a pair with, e.g., `npx web-push
# generate-vapid-keys` or webpush.GenerateVAPIDKeys() from
# github.com/SherClockHolmes/webpush-go.
#MCP_SWITCHBOARD_PUSH_VAPID_PUBLIC_KEY=
#MCP_SWITCHBOARD_PUSH_VAPID_PRIVATE_KEY=

# --- observability --------------------------------------------------------
#MCP_SWITCHBOARD_LOKI_ENABLED=true
#MCP_SWITCHBOARD_LOKI_URL=http://127.0.0.1:3100
#MCP_SWITCHBOARD_LOKI_LABELS=service=mcp-switchboard,env=home
#MCP_SWITCHBOARD_RETENTION_DAYS=30
#MCP_SWITCHBOARD_MAX_ROWS=100000

# --- LLM providers (agents) -----------------------------------------------
# Ollama is detected automatically behind the openai-compatible base URL and
# spoken to natively so the context window can be set per request.
#MCP_SWITCHBOARD_LLM_OPENAI_COMPATIBLE_KIND=auto
#MCP_SWITCHBOARD_LLM_OPENAI_COMPATIBLE_DISCOVER=true
#MCP_SWITCHBOARD_LLM_OLLAMA_NUM_CTX=0
