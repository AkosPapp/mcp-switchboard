# mcp-switchboard configuration.
#
# Every setting can be given either literally or as a path to a file holding the
# value - any value starting with "/" that is an existing regular file is read
# from that file. That is how secrets are passed under NixOS/sops without any
# separate *_FILE variables:
#
#   MCP_SWITCHBOARD_TUNNEL_TOKEN=/run/secrets/mcp-switchboard/tunnel-token

# --- client ---------------------------------------------------------------
MCP_SWITCHBOARD_HUB_URL=wss://switchboard.example.com
MCP_SWITCHBOARD_TUNNEL_TOKEN=change-me
# Identifies this machine, and is what tools get tagged with. Defaults to the hostname.
#MCP_SWITCHBOARD_LABEL=legion5
#MCP_SWITCHBOARD_CONFIG=./mcp.json

# --- hub ------------------------------------------------------------------
# The tunnel listener is the only one meant to be publicly reachable, and always
# needs the token above. The private listener (console, /api, /mcp, /metrics)
# binds loopback and is unauthenticated by default.
#MCP_SWITCHBOARD_TUNNEL_HOST=127.0.0.1
#MCP_SWITCHBOARD_TUNNEL_PORT=8097
#MCP_SWITCHBOARD_PRIVATE_HOST=127.0.0.1
#MCP_SWITCHBOARD_PRIVATE_PORT=8099
#MCP_SWITCHBOARD_PRIVATE_TOKEN=
#MCP_SWITCHBOARD_DATA_DIR=/var/lib/mcp-switchboard
#MCP_SWITCHBOARD_LOG_LEVEL=INFO

# --- observability --------------------------------------------------------
#MCP_SWITCHBOARD_LOKI_ENABLED=true
#MCP_SWITCHBOARD_LOKI_URL=http://127.0.0.1:3100
#MCP_SWITCHBOARD_LOKI_LABELS=service=mcp-switchboard,env=home
#MCP_SWITCHBOARD_RETENTION_DAYS=30
#MCP_SWITCHBOARD_MAX_ROWS=100000
